{
  "baseUrl": "http://icontrol.paccool.be",
  "loginUrl": "http://icontrol.paccool.be/en/auth/login",
  "homeUrl": "http://icontrol.paccool.be/en/home",
  "locale": "en",
  "csrfTokenSelectors": [
    "input[name='_token']",
    "input[name='csrf_token']",
    "input[name='_csrf']",
    "meta[name='csrf-token']"
  ],
  "dataStructure": {
    "comment": "PACCOOL shows data in panels. Info panel has tank details, Latest panel has temperature data",
    "infoPanelHeading": "Info",
    "latestPanelHeading": "Latest",
    "successPanelHeading": "Success"
  },
  "endpoints": {
    "tankDetailPattern": "/en/tankdetail/{tankId}/{serial}",
    "postData": "/en/post",
    "postTimer": "/en/post_timer"
  }
}
